# Cihaz başına günlük üretim sınırı (maliyet koruması).
DAILY_LIMIT_PER_DEVICE=30
# İç mimar taleplerinin iletileceği webhook (Slack, Discord, n8n, Zapier…). İsteğe bağlı.
LEAD_WEBHOOK_URL=
