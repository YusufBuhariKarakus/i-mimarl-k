PORT=8787
# Görsellerin dışarıdan erişilen adresi (ör. https://api.odaai.app). Boşsa istek Host başlığı kullanılır.
PUBLIC_URL=

# --- Görsel üretimi ---
# Boş bırakılırsa sunucu "mock" modda çalışır: yüklenen fotoğrafı geri döndürür.
REPLICATE_API_TOKEN=
# Replicate'teki img2img / iç mekân modeli (owner/name). Modelin girdi alanları
# farklıysa src/generate.ts içindeki `input` nesnesini uyarlayın.
REPLICATE_MODEL=

# --- Haklar (kredi / Pro) ---
# RevenueCat gizli (secret) API anahtarı. Boşsa geliştirme modu: sahte satın
# alımlar sunucuya kaydedilir (NODE_ENV=production iken kapalıdır).
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro
# Yeni cihaza verilen ücretsiz tasarım hakkı.
FREE_CREDITS=1
# Cihaz başına günlük üretim sınırı (Pro dahil, maliyet koruması).
DAILY_LIMIT_PER_DEVICE=30

# --- Diğer ---
# İç mimar taleplerinin iletileceği webhook (Slack, Discord, n8n, Zapier…). İsteğe bağlı.
LEAD_WEBHOOK_URL=
# Web sürümü için izin verilen köken. Varsayılan: *
CORS_ORIGIN=
