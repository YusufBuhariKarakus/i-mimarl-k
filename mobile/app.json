{
  "expo": {
    "name": "OdaAI",
    "slug": "odaai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.odaai.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4EFE8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.odaai.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Odan\u0131z\u0131n foto\u011fraf\u0131n\u0131 yeniden tasarlamak i\u00e7in galerinize eri\u015fmemiz gerekiyor.",
          "cameraPermission": "Odan\u0131z\u0131n foto\u011fraf\u0131n\u0131 \u00e7ekmek i\u00e7in kameran\u0131za eri\u015fmemiz gerekiyor."
        }
      ]
    ],
    "scheme": "odaai",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8787"
    }
  }
}
